{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TitleChain-Foundation/M5-AI-Sovereign-Commons/main/pilots/312-spring-commons/simulations/first-tranche/m5-x402/m5-x402-extension.schema.json",
  "title": "M5 Ricardian x402 Extension",
  "description": "Draft x402 v2 extension binding human terms, machine policy, executable instructions, authority evidence, and a separately typed no-value project marker. Structural validation creates no authority or settlement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["info", "schema"],
  "properties": {
    "info": { "$ref": "#/$defs/info" },
    "schema": { "type": "object" }
  },
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "uri": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "tokenRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "asset_code", "quantity", "valuation_status", "transferability", "redeemability", "fee_title_effect", "security_or_investment_rights", "settlement_eligibility"],
      "properties": {
        "token_id": { "type": "string" },
        "asset_code": { "const": "M5MARKER" },
        "quantity": { "const": "1" },
        "valuation_status": { "const": "NO_ASSIGNED_MONETARY_VALUE" },
        "transferability": { "const": "NON_TRANSFERABLE" },
        "redeemability": { "const": "NONE" },
        "fee_title_effect": { "const": "NONE" },
        "security_or_investment_rights": { "const": "NONE_UNLESS_SEPARATELY_CREATED" },
        "settlement_eligibility": { "const": "NOT_A_SETTLEMENT_ASSET" }
      }
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contract", "human_terms", "machine_policy", "executable_plan", "authority", "token_representation", "execution_safety", "request_fingerprint"],
      "properties": {
        "profile": { "const": "M5-X402-001-draft" },
        "contract": { "$ref": "#/$defs/artifactBinding" },
        "human_terms": { "$ref": "#/$defs/artifactBinding" },
        "machine_policy": { "$ref": "#/$defs/artifactBinding" },
        "executable_plan": { "$ref": "#/$defs/artifactBinding" },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal_ref", "role_ref", "credential_state", "delegation_ref", "approval_state", "evidence_refs"],
          "properties": {
            "principal_ref": { "type": "string" },
            "role_ref": { "type": "string" },
            "credential_state": { "enum": ["PENDING_EXTERNAL", "CURRENT", "STALE", "REVOKED", "DISPUTED"] },
            "delegation_ref": { "type": ["string", "null"] },
            "approval_state": { "enum": ["PENDING_EXTERNAL", "APPROVED", "REFUSED", "REVOKED"] },
            "evidence_refs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "token_representation": { "$ref": "#/$defs/tokenRepresentation" },
        "execution_safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["synthetic", "authority_effect", "network_write", "financial_movement", "settlement_status"],
          "properties": {
            "synthetic": { "const": true },
            "authority_effect": { "const": "NONE" },
            "network_write": { "const": false },
            "financial_movement": { "const": false },
            "settlement_status": { "const": "NOT_SUBMITTED" }
          }
        },
        "request_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payment_id", "http_method", "resource", "scheme", "network", "asset", "amount", "pay_to", "operation_id"],
          "properties": {
            "payment_id": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
            "http_method": { "type": "string" },
            "resource": { "type": "string" },
            "scheme": { "type": "string" },
            "network": { "type": "string" },
            "asset": { "not": { "const": "M5MARKER" } },
            "amount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "pay_to": { "type": "string" },
            "operation_id": { "type": "string" }
          }
        }
      }
    }
  }
}
