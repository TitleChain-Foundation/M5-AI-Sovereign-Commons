{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TitleChain-Foundation/M5-AI-Sovereign-Commons/main/pilots/312-spring-commons/schemas/spring-commons-human-terms-manifest.schema.json",
  "title": "Spring Commons DOC-01–23 Human-Terms Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "contract_id", "artifact_id", "artifact_version", "supersession_history", "digest_algorithm", "digest_scope", "documents"],
  "properties": {
    "manifest_schema_version": {"const": "1.0"},
    "contract_id": {"const": "PPT-EZ-CA-0001-ILLUSTRATIVE-PRIVATE-TRANCHE-01"},
    "artifact_id": {"const": "SPRING-COMMONS-DOC-SET-01-23"},
    "artifact_version": {"const": "v0.6-draft-package"},
    "supersession_history": {
      "type": "object", "additionalProperties": false, "required": ["supersedes", "superseded_by"],
      "properties": {"supersedes": {"type": "array", "items": {"type": "string"}}, "superseded_by": {"type": ["string", "null"]}}
    },
    "digest_algorithm": {"const": "sha256"},
    "digest_scope": {"const": "Exact bytes of each URI-resolved PDF"},
    "documents": {
      "type": "array", "minItems": 23, "maxItems": 23, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version", "uri", "digest"],
        "properties": {
          "id": {"pattern": "^DOC-(0[1-9]|1[0-9]|2[0-3])$"},
          "version": {"const": "v0.6-draft"},
          "uri": {"type": "string", "pattern": "^\\.\\./\\.\\./\\.\\./documents/public/DOC-(0[1-9]|1[0-9]|2[0-3])-[^/]+\\.pdf$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
