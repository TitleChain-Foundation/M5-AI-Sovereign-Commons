{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TitleChain-Foundation/M5-AI-Sovereign-Commons/main/pilots/312-spring-commons/schemas/m5-first-tranche-receipt.schema.json",
  "title": "M5 Spring Commons First-Tranche Simulation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "receipt_version", "receipt_class",
    "simulation_id", "project_id", "tranche_id", "m5canon", "artifacts",
    "decision_record", "decision_context", "actor_authority", "approvals",
    "adapter_provider_refs", "receipt_access", "ordering",
    "decision", "execution_authorized", "authority_effect",
    "network_write_performed", "financial_movement_performed",
    "checkpoint_summary", "state_transition", "exceptions", "reconciliation",
    "observations", "notices"
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "uri"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "uri": { "type": "string", "minLength": 1 }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function_id", "function_uri", "policy_version", "implementation_id", "implementation_version", "outcome"],
      "properties": {
        "function_id": { "type": "string" },
        "function_uri": { "type": "string" },
        "policy_version": { "const": "M5-RICARDIAN-TRIPLE-LAYER-001:draft-2026-09-20" },
        "implementation_id": { "const": "SPRING-COMMONS-FIRST-TRANCHE-EVALUATOR" },
        "implementation_version": { "const": "1.1.0-draft" },
        "outcome": { "enum": ["HOLD", "UNRESOLVED", "SATISFIED", "READY_FOR_AUTHORIZED_HUMAN_REVIEW", "COMMITTED_SIMULATION_RECEIPT"] }
      },
      "oneOf": [
        { "properties": { "function_id": { "const": "M5CANON.PRINCIPAL.RESOLVE.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:principal:resolve:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.CREDENTIAL.VERIFY.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:credential:verify:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.DELEGATION.VERIFY.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:delegation:verify:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.JURISDICTION.RESOLVE.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:jurisdiction:resolve:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.POLICY.EVALUATE.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:policy:evaluate:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.APPROVAL.VERIFY.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:approval:verify:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.ACTION.AUTHORIZE.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:action:authorize:v1" } } },
        { "properties": { "function_id": { "const": "M5CANON.RECEIPT.COMMIT.v1" }, "function_uri": { "const": "urn:m5:function:m5canon:receipt:commit:v1" } } }
      ]
    },
    "state": {
      "enum": ["CURRENT", "PENDING", "STALE", "EXPIRED", "REVOKED", "DISPUTED", "UNRESOLVED", "NOT_REVOKED"]
    }
  },
  "properties": {
    "schema_version": { "const": "1.0-draft" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "receipt_version": { "const": "1.2" },
    "receipt_class": { "const": "PUBLIC_SYNTHETIC_NON_AUTHORITATIVE" },
    "simulation_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "tranche_id": { "type": "string", "minLength": 1 },
    "m5canon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "functions"],
      "properties": {
        "policy_version": { "const": "M5-RICARDIAN-TRIPLE-LAYER-001:draft-2026-09-20" },
        "functions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/function" },
          "allOf": [
            { "contains": { "properties": { "function_id": { "const": "M5CANON.PRINCIPAL.RESOLVE.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.CREDENTIAL.VERIFY.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.DELEGATION.VERIFY.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.JURISDICTION.RESOLVE.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.POLICY.EVALUATE.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.APPROVAL.VERIFY.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.ACTION.AUTHORIZE.v1" } }, "required": ["function_id"] } },
            { "contains": { "properties": { "function_id": { "const": "M5CANON.RECEIPT.COMMIT.v1" } }, "required": ["function_id"] } }
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "human_terms_manifest", "machine_policy", "executable_instruction", "decision_context", "taxonomy_profile"],
      "properties": {
        "fixture": { "$ref": "#/$defs/artifact" },
        "human_terms_manifest": { "$ref": "#/$defs/artifact" },
        "machine_policy": { "$ref": "#/$defs/artifact" },
        "executable_instruction": { "$ref": "#/$defs/artifact" },
        "decision_context": { "$ref": "#/$defs/artifact" },
        "taxonomy_profile": { "$ref": "#/$defs/artifact" }
      }
    },
    "decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "result", "unresolved_requirements", "receipt_ref"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "result": { "enum": ["HOLD", "READY_FOR_AUTHORIZED_HUMAN_REVIEW"] },
        "unresolved_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "receipt_ref": { "type": "string", "minLength": 1 }
      }
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_ref", "taxonomy_profile_ref", "asset_ref", "m5_class", "external_legal_classification_ref", "jurisdiction_graph_ref", "account_ref", "account_type", "human_principal_refs", "credential_state", "delegation_state", "mandate_ref", "mandate_state", "revocation_state", "institutional_route_ref", "institutional_route_status", "receipt_access_policy_ref"],
      "properties": {
        "context_ref": { "type": "string" },
        "taxonomy_profile_ref": { "type": "string" },
        "asset_ref": { "type": "string" },
        "m5_class": { "enum": ["M1", "M2", "M3", "M4", "M5", "UNRESOLVED"] },
        "external_legal_classification_ref": { "type": "string" },
        "jurisdiction_graph_ref": { "type": "string" },
        "account_ref": { "type": "string" },
        "account_type": { "enum": ["BOM", "BOU", "BOB", "BOI", "BOG", "UNRESOLVED"] },
        "human_principal_refs": { "type": "array", "items": { "type": "string" } },
        "credential_state": { "$ref": "#/$defs/state" },
        "delegation_state": { "$ref": "#/$defs/state" },
        "mandate_ref": { "type": "string" },
        "mandate_state": { "$ref": "#/$defs/state" },
        "revocation_state": { "$ref": "#/$defs/state" },
        "institutional_route_ref": { "type": "string" },
        "institutional_route_status": { "$ref": "#/$defs/state" },
        "receipt_access_policy_ref": { "type": "string" }
      }
    },
    "actor_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_ref", "principal_ref", "legal_entity_ref", "account_ref", "account_type", "role_ref", "credential_refs", "credential_state", "delegation_refs", "delegation_state", "mandate_ref", "mandate_state", "jurisdiction_refs", "revocation_state", "authority_evidence_refs"],
      "properties": {
        "actor_ref": { "type": "string" },
        "principal_ref": { "type": "string" },
        "legal_entity_ref": { "type": "string" },
        "account_ref": { "type": "string" },
        "account_type": { "enum": ["BOM", "BOU", "BOB", "BOI", "BOG", "UNRESOLVED"] },
        "role_ref": { "type": "string" },
        "credential_refs": { "type": "array", "items": { "type": "string" } },
        "credential_state": { "$ref": "#/$defs/state" },
        "delegation_refs": { "type": "array", "items": { "type": "string" } },
        "delegation_state": { "$ref": "#/$defs/state" },
        "mandate_ref": { "type": "string" },
        "mandate_state": { "$ref": "#/$defs/state" },
        "jurisdiction_refs": { "type": "array", "items": { "type": "string" } },
        "revocation_state": { "$ref": "#/$defs/state" },
        "authority_evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["approval_ref", "approval_type", "status", "evidence_refs"],
        "properties": { "approval_ref": { "type": "string" }, "approval_type": { "type": "string" }, "status": { "$ref": "#/$defs/state" }, "evidence_refs": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "adapter_provider_refs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["participant_ref", "institution_identifier", "function", "required_action", "status", "evidence_refs"],
        "properties": { "participant_ref": { "type": "string" }, "institution_identifier": { "enum": ["M5_DTTC", "DTCC", "DTC", "NSCC", "FICC", "SEC", "CFTC", "OTHER"] }, "function": { "type": "string" }, "required_action": { "type": "string" }, "status": { "$ref": "#/$defs/state" }, "evidence_refs": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "receipt_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "policy_digest", "default_access", "public_field_scope", "protected_field_classes", "authorized_grant_refs", "pending_grant_refs", "access_log_required", "access_log_refs"],
      "properties": {
        "policy_ref": { "type": "string" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "default_access": { "const": "DENY" },
        "public_field_scope": { "type": "array", "items": { "type": "string" } },
        "protected_field_classes": { "type": "array", "items": { "type": "string" } },
        "authorized_grant_refs": { "type": "array", "items": { "type": "string" } },
        "pending_grant_refs": { "type": "array", "items": { "type": "string" } },
        "access_log_required": { "const": true },
        "access_log_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "sequence", "anchor", "previous_receipt_digest"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "sequence": { "type": "integer", "minimum": 0 },
        "anchor": { "enum": ["GENESIS", "PREVIOUS_RECEIPT"] },
        "previous_receipt_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "anchor": { "const": "GENESIS" } } }, "then": { "properties": { "previous_receipt_digest": { "type": "null" } } } },
        { "if": { "properties": { "anchor": { "const": "PREVIOUS_RECEIPT" } } }, "then": { "properties": { "previous_receipt_digest": { "$ref": "#/$defs/digest" } } } }
      ]
    },
    "decision": { "enum": ["HOLD", "READY_FOR_AUTHORIZED_HUMAN_REVIEW"] },
    "execution_authorized": { "const": false },
    "authority_effect": { "const": "NONE" },
    "network_write_performed": { "const": false },
    "financial_movement_performed": { "const": false },
    "checkpoint_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "satisfied", "unresolved_checkpoint_ids", "unresolved_context_requirements"],
      "properties": {
        "required": { "type": "integer", "minimum": 0 },
        "satisfied": { "type": "integer", "minimum": 0 },
        "unresolved_checkpoint_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "unresolved_context_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": 5 } }, "required": ["required"] },
          "then": { "properties": { "satisfied": { "maximum": 5 } } }
        }
      ]
    },
    "state_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_state", "requested_state", "resulting_state"],
      "properties": {
        "prior_state": { "type": "string" },
        "requested_state": { "type": "string" },
        "resulting_state": { "type": "string" }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "detail"],
        "properties": {
          "code": { "type": "string" },
          "status": { "const": "UNRESOLVED" },
          "detail": { "type": "string" }
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider_receipt_refs"],
      "properties": {
        "status": { "const": "NOT_APPLICABLE_SIMULATION" },
        "provider_receipt_refs": { "type": "array", "maxItems": 0 }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_digest", "validation_status"],
      "properties": {
        "fixture_digest": { "$ref": "#/$defs/digest" },
        "validation_status": { "enum": ["VALID", "INVALID_UNRESOLVED"] }
      }
    },
    "notices": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
