{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TitleChain-Foundation/M5-AI-Sovereign-Commons/main/pilots/dagny-bank-of-me/schemas/m5-value-receipt-bundle.schema.json",
  "title": "Synthetic M5 Value Receipt Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_class",
    "simulation_id",
    "exchange_id",
    "provider_tcid",
    "receiver_tcid",
    "execution_safety",
    "exchange_resource",
    "agreed_total",
    "leg_total",
    "consideration_reconciled",
    "receipts",
    "bundle_hash",
    "notices"
  ],
  "properties": {
    "schema_version": { "const": "0.1-draft" },
    "receipt_class": { "const": "PUBLIC_SYNTHETIC_NON_AUTHORITATIVE" },
    "simulation_id": { "type": "string", "minLength": 1 },
    "exchange_id": { "type": "string", "minLength": 1 },
    "provider_tcid": { "type": "string", "minLength": 1 },
    "receiver_tcid": { "type": "string", "minLength": 1 },
    "execution_safety": { "$ref": "#/$defs/executionSafety" },
    "exchange_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_reference", "description", "quantity"],
      "properties": {
        "resource_type": { "enum": ["DIGITAL", "CASH", "ASSET", "SERVICE"] },
        "resource_reference": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$" }
      }
    },
    "agreed_total": { "$ref": "#/$defs/money" },
    "leg_total": { "$ref": "#/$defs/money" },
    "consideration_reconciled": { "const": true },
    "receipts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/receipt" }
    },
    "bundle_hash": { "$ref": "#/$defs/digest" },
    "notices": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3,12}$" }
      }
    },
    "executionSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "authority_effect",
        "network_write",
        "financial_movement",
        "real_world_resource_movement"
      ],
      "properties": {
        "synthetic": { "const": true },
        "authority_effect": { "const": "NONE" },
        "network_write": { "const": false },
        "financial_movement": { "const": false },
        "real_world_resource_movement": { "const": false }
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "receiver"],
      "properties": {
        "provider": { "const": "SYNTHETIC_ACKNOWLEDGED" },
        "receiver": { "const": "SYNTHETIC_ACKNOWLEDGED" }
      }
    },
    "feeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "bps", "applied", "source_reference"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "PROVIDER_RAIL",
            "M5_PROTOCOL",
            "SETTLEMENT",
            "BRIDGE",
            "TRANSFER_AGENT",
            "JURISDICTION",
            "ASSET_CLASS"
          ]
        },
        "bps": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "applied": { "type": "boolean" },
        "source_reference": { "type": "string", "minLength": 1 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "event_id",
        "exchange_id",
        "provider_tcid",
        "receiver_tcid",
        "resource_type",
        "settlement_type",
        "exchange_resource_reference",
        "resource_reference",
        "quantity",
        "agreed_value",
        "valuation_currency",
        "evidence_refs",
        "credential_context",
        "jurisdiction_context",
        "policy_context",
        "provider_attestation",
        "receiver_attestation",
        "created_at",
        "accepted_at",
        "receipt_hash",
        "m5pod_record_ref",
        "titlechain_reference",
        "state",
        "simulation_outcome"
      ],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "exchange_id": { "type": "string", "minLength": 1 },
        "provider_tcid": { "type": "string", "minLength": 1 },
        "receiver_tcid": { "type": "string", "minLength": 1 },
        "resource_type": { "enum": ["DIGITAL", "CASH", "ASSET", "SERVICE"] },
        "settlement_type": { "enum": ["DIGITAL", "CASH", "ASSET", "SERVICE"] },
        "exchange_resource_reference": { "type": "string", "minLength": 1 },
        "resource_reference": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$" },
        "agreed_value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$" },
        "valuation_currency": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        },
        "credential_context": { "type": "string" },
        "jurisdiction_context": { "type": "string" },
        "policy_context": { "type": "string" },
        "provider_attestation": { "const": "SYNTHETIC_ACKNOWLEDGED" },
        "receiver_attestation": { "const": "SYNTHETIC_ACKNOWLEDGED" },
        "created_at": { "type": "string", "format": "date-time" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "receipt_hash": { "$ref": "#/$defs/digest" },
        "m5pod_record_ref": { "type": "string" },
        "titlechain_reference": { "type": ["string", "null"] },
        "state": { "const": "PROPOSED" },
        "simulation_outcome": { "enum": ["402_HOLD_BEFORE_PROVIDER", "SIMULATED_ACKNOWLEDGEMENT_ONLY"] },
        "digital_settlement_terms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payment_wrapper",
            "m5_extension",
            "adapter",
            "provider_candidate",
            "provider_status",
            "settlement_asset",
            "fx_quote",
            "transaction_fee_components",
            "allocation_basis",
            "allocation_route",
            "total_fee_bps",
            "gross_amount",
            "fee_amount",
            "net_amount"
          ],
          "properties": {
            "payment_wrapper": { "const": "x402-v2" },
            "m5_extension": { "const": "M5-x402-draft" },
            "adapter": { "const": "M5Pay" },
            "provider_candidate": { "const": "BRALE_PRIVATE_LABEL_STABLECOIN" },
            "provider_status": { "const": "CANDIDATE_NOT_CALLED" },
            "settlement_asset": { "type": "string", "minLength": 1 },
            "fx_quote": { "type": "object" },
            "transaction_fee_components": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/feeComponent" }
            },
            "allocation_basis": {
              "const": "COLLECTED_M5_ECONOMICS_NOT_TRANSACTION_PRINCIPAL"
            },
            "allocation_route": {
              "type": "array",
              "prefixItems": [
                { "const": "COMMUNITY_BY_PERSON_CHAIN_AND_POSTAL_JURISDICTION" },
                { "const": "M5_PROTOCOL" },
                { "const": "LOCAL_STATE_NATION_RULE" }
              ],
              "items": false
            },
            "total_fee_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "gross_amount": { "$ref": "#/$defs/money" },
            "fee_amount": { "$ref": "#/$defs/money" },
            "net_amount": { "$ref": "#/$defs/money" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "settlement_type": { "const": "DIGITAL" } }, "required": ["settlement_type"] },
          "then": {
            "required": ["digital_settlement_terms"],
            "properties": {
              "simulation_outcome": { "const": "402_HOLD_BEFORE_PROVIDER" }
            }
          },
          "else": {
            "not": { "required": ["digital_settlement_terms"] },
            "properties": {
              "simulation_outcome": { "const": "SIMULATED_ACKNOWLEDGEMENT_ONLY" }
            }
          }
        },
        {
          "if": { "properties": { "settlement_type": { "const": "CASH" } }, "required": ["settlement_type"] },
          "then": {
            "properties": {
              "titlechain_reference": { "const": null }
            }
          }
        }
      ]
    }
  }
}
