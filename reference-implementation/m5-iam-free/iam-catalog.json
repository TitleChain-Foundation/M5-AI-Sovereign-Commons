      "name": "Bank of Us",
      "for": "Family, co-op, nonprofit or trust",
      "price": "$79 per year \u00b7 pending launch",
      "adds": "An account that belongs to the group, with roles for the people who run it."
    },
    {
      "tier": "M3",
      "name": "Bank of Business",
      "for": "Your business",
      "price": "$99 per year \u00b7 pending launch",
      "adds": "An account that belongs to the business, with roles, signers and its own workflows."
    },
    {
      "tier": "M4",
      "name": "Bank of Institutions",
      "for": "A verified institution",
      "price": "$250 per year \u00b7 pending launch",
