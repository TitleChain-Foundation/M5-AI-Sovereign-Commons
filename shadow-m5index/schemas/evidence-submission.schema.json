{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHADOW Evidence Submission",
  "type": "object",
  "required": [
    "submission_id",
    "asset_id",
    "evidence_id",
    "evidence_type",
    "source",
    "evidence_state"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "pattern": "^SUB-[0-9]{4}-[0-9]{6,}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^SHD-[0-9]{3,}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EVD-[0-9]{4}-[0-9]{6,}$"
    },
    "evidence_type": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "office": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrument_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim_supported": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_state": {
      "enum": [
        "SUBMITTED",
        "SOURCE_VERIFIED",
        "CORROBORATED",
        "CANONICAL",
        "DISPUTED",
        "UNRESOLVED",
        "REJECTED",
        "CORRECTED",
        "SUPERSEDED"
      ]
    }
  }
}
