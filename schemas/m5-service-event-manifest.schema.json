{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:service-event-manifest:v1",
  "title": "M5 Service Event Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_id",
    "provider_account_ref",
    "provider_account_type",
    "event_types",
    "capability_refs",
    "jurisdiction_binding_refs",
    "modules",
    "data_rights",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "service_id": {
      "type": "string"
    },
    "provider_account_ref": {
      "type": "string"
    },
    "provider_account_type": {
      "enum": [
        "M5BOU",
        "M5BOB",
        "M5BOI",
        "M5BOG"
      ]
    },
    "event_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "capability_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^M5CAP\\.[A-Z_]+(?:\\.[A-Z_]+)+\\.v[1-9][0-9]*$"
      }
    },
    "jurisdiction_binding_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metering",
        "orbitalys",
        "titlechain_receipts",
        "m5canon",
        "commerce",
        "x402",
        "m5global_aggregate"
      ],
      "properties": {
        "metering": {
          "type": "boolean"
        },
        "orbitalys": {
          "type": "boolean"
        },
        "titlechain_receipts": {
          "type": "boolean"
        },
        "m5canon": {
          "type": "boolean"
        },
        "commerce": {
          "type": "boolean"
        },
        "x402": {
          "type": "boolean"
        },
        "m5global_aggregate": {
          "type": "boolean"
        }
      }
    },
    "data_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commercial_use",
        "redistribution",
        "derived_outputs",
        "retention_policy_ref"
      ],
      "properties": {
        "commercial_use": {
          "type": "boolean"
        },
        "redistribution": {
          "type": "boolean"
        },
        "derived_outputs": {
          "type": "boolean"
        },
        "retention_policy_ref": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "effective_at",
        "expires_at",
        "revocation_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "effective_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revocation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
