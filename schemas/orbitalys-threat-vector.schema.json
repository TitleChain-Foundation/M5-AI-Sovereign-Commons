{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:orbitalys-threat-vector:v1",
  "title": "Orbitalys Threat Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vector_id",
    "source_event_ref",
    "domain",
    "vector_type",
    "severity",
    "confidence",
    "affected_refs",
    "evidence_refs",
    "recommended_control",
    "authority_effect",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "vector_id": {
      "type": "string"
    },
    "source_event_ref": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "IDENTITY",
        "CREDENTIAL",
        "JURISDICTION",
        "TITLE",
        "RIGHTS",
        "DEBT",
        "M4_INSTRUMENT",
        "PROVIDER",
        "ENDPOINT",
        "AGENT",
        "MODEL",
        "PAYMENT",
        "PROVENANCE",
        "LICENSE",
        "OTHER"
      ]
    },
    "vector_type": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "affected_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_control": {
      "enum": [
        "MONITOR",
        "REVERIFY",
        "STEP_UP_AUTHENTICATION",
        "REQUIRE_ADDITIONAL_EVIDENCE",
        "REQUIRE_HUMAN_REVIEW",
        "PAUSE_PENDING_REVIEW"
      ]
    },
    "authority_effect": {
      "const": "NONE"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
