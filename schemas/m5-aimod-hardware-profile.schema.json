{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:aimod-hardware-profile:v1",
  "title": "M5 AIMOD Hardware Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "system", "workload", "measurements", "measured_at", "measurement_method", "certification_claim", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "system": {"type": "object", "additionalProperties": false, "required": ["processor", "accelerator", "memory_bytes", "runtime"], "properties": {"processor": {"type": "string"}, "accelerator": {"type": ["string", "null"]}, "memory_bytes": {"type": "integer", "minimum": 1}, "runtime": {"type": "string"}}},
    "workload": {"type": "object", "additionalProperties": false, "required": ["artifact_digest", "parameters", "input_description"], "properties": {"artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "parameters": {"type": "object"}, "input_description": {"type": "string"}}},
    "measurements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["metric", "value", "unit"], "properties": {"metric": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}}}},
    "measured_at": {"type": "string", "format": "date-time"},
    "measurement_method": {"type": "string", "minLength": 1},
    "certification_claim": {"const": false},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sequence", "actor_ref", "timestamp", "digest"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "actor_ref": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}
  }
}
