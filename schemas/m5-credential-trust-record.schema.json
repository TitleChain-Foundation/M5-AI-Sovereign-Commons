{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:credential-trust-record:v1",
  "title": "M5 Credential / Evidence Trust Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_record_id",
    "issuer_or_source_ref",
    "evidence_format",
    "claim_types",
    "trust_scope",
    "profile_state",
    "official_source_refs",
    "reviewed_at",
    "effective_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "trust_record_id": {
      "type": "string"
    },
    "issuer_or_source_ref": {
      "type": "string"
    },
    "evidence_format": {
      "enum": [
        "W3C_VC_2_0",
        "VLEI",
        "OIDC_ASSERTION",
        "SAML_ASSERTION",
        "API_ATTESTATION",
        "REGISTRY_RECORD",
        "OTHER_PROFILED"
      ]
    },
    "claim_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "trust_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "jurisdiction_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_state": {
      "enum": [
        "REFERENCE_ONLY",
        "EVALUATED",
        "APPROVED_FOR_PROFILE",
        "SUSPENDED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "official_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revocation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "endorsed": {
      "const": false
    }
  }
}
