{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:provider-plugin-manifest:v2",
  "title": "Provider Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_id",
    "provider",
    "capabilities",
    "permissions",
    "jurisdiction_binding_refs",
    "lifecycle",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^urn:m5:plugin:[a-z0-9._-]+$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "m5_account_ref",
        "account_type",
        "accountable_entity_ref",
        "enrollment_status",
        "verification_status",
        "account_lifecycle",
        "standing",
        "evidence_stack",
        "endorsed",
        "status_checked_at"
      ],
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "m5_account_ref": {
          "type": "string"
        },
        "account_type": {
          "enum": [
            "M5BOU",
            "M5BOB",
            "M5BOI",
            "M5BOG"
          ]
        },
        "accountable_entity_ref": {
          "type": "string"
        },
        "parent_account_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "enrollment_status": {
          "enum": [
            "not_enrolled",
            "pending",
            "enrolled",
            "suspended",
            "revoked",
            "expired"
          ]
        },
        "verification_status": {
          "enum": [
            "unverified",
            "pending",
            "verified",
            "failed",
            "disputed",
            "expired"
          ]
        },
        "account_lifecycle": {
          "enum": [
            "pending",
            "active",
            "suspended",
            "revoked",
            "expired"
          ]
        },
        "standing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "credential_refs",
            "verified_at",
            "expires_at",
            "revocation_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "GOOD_STANDING",
                "PENDING",
                "SUSPENDED",
                "REVOKED",
                "EXPIRED",
                "DISPUTED",
                "UNKNOWN"
              ]
            },
            "credential_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "revocation_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "evidence_stack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_type",
              "source_ref",
              "observed_at"
            ],
            "properties": {
              "evidence_type": {
                "enum": [
                  "OFFICIAL_REGISTRY",
                  "OPENCORPORATES",
                  "LEI",
                  "VLEI",
                  "W3C_VC",
                  "IDENTITY_PROOFING",
                  "PROFESSIONAL_REGISTRY",
                  "REGULATORY_REGISTRY",
                  "OTHER_PROFILED"
                ]
              },
              "source_ref": {
                "type": "string"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "endorsed": {
          "const": false
        },
        "status_checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "account_type": {
                "const": "M5BOU"
              }
            }
          },
          "then": {
            "required": [
              "parent_account_ref",
              "delegation_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "account_type": {
                "const": "M5BOU"
              }
            },
            "required": [
              "account_type"
            ]
          },
          "then": {
            "required": [
              "parent_account_ref",
              "delegation_ref"
            ],
            "properties": {
              "parent_account_ref": {
                "type": "string",
                "minLength": 1
              },
              "delegation_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function_id",
          "named_role",
          "bounded",
          "inputs",
          "outputs"
        ],
        "properties": {
          "function_id": {
            "type": "string",
            "pattern": "^M5CAP\\.[A-Z0-9_.]+\\.v[1-9][0-9]*$"
          },
          "named_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "bounded": {
            "const": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "jurisdiction_binding_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "effective_at",
        "expires_at",
        "revocation_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "active",
            "suspended",
            "revoked",
            "expired"
          ]
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revocation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_type",
          "timestamp",
          "actor_ref",
          "digest"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "event_type": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor_ref": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
