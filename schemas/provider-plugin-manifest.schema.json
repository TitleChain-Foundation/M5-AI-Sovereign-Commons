{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:provider-plugin-manifest:v1",
  "title": "Provider Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "provider", "capabilities", "permissions", "lifecycle", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plugin_id": {"type": "string", "pattern": "^urn:m5:plugin:[a-z0-9._-]+$"},
    "provider": {"$ref": "#/$defs/provider"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
    "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "accountable_entity_ref", "enrollment_status", "verification_status", "endorsed", "status_checked_at"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "accountable_entity_ref": {"type": "string", "minLength": 1},
        "enrollment_status": {"enum": ["not_enrolled", "pending", "enrolled", "suspended", "revoked", "expired"]},
        "verification_status": {"enum": ["unverified", "pending", "verified", "failed", "disputed", "expired"]},
        "endorsed": {"const": false},
        "status_checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["function_id", "named_role", "bounded", "inputs", "outputs"],
      "properties": {
        "function_id": {"type": "string", "pattern": "^M5CAP\\.[A-Z0-9_.]+\\.v[1-9][0-9]*$"},
        "named_role": {"type": ["string", "null"]},
        "bounded": {"const": true},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "effective_at", "expires_at", "revocation_ref"],
      "properties": {
        "status": {"enum": ["draft", "active", "suspended", "revoked", "expired"]},
        "effective_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revocation_ref": {"type": ["string", "null"]}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "event_type", "timestamp", "actor_ref", "digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "event_type": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "actor_ref": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
