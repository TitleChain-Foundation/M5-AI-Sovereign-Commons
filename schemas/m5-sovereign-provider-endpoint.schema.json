{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:sovereign-provider-endpoint:v1",
  "title": "M5 Sovereign Provider Endpoint",
  "description": "Sovereign is descriptive terminology and conveys no governmental or legal status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "endpoint_id", "provider", "origin", "protocol", "credential_method", "redirect_policy", "data_residency", "capability_function_ids", "lifecycle"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "endpoint_id": {"type": "string", "minLength": 1},
    "provider": {"type": "object", "additionalProperties": false, "required": ["provider_id", "accountable_entity_ref", "enrollment_status", "verification_status", "endorsed", "evidence_refs"], "properties": {"provider_id": {"type": "string"}, "accountable_entity_ref": {"type": "string"}, "enrollment_status": {"enum": ["not_enrolled", "pending", "enrolled", "suspended", "revoked", "expired"]}, "verification_status": {"enum": ["unverified", "pending", "verified", "failed", "disputed", "expired"]}, "endorsed": {"const": false}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}},
    "origin": {"type": "string", "format": "uri", "pattern": "^https://[^/]+$"},
    "protocol": {"enum": ["https", "wss"]},
    "credential_method": {"type": "string", "minLength": 1},
    "redirect_policy": {"type": "object", "additionalProperties": false, "required": ["allowed", "allowlist"], "properties": {"allowed": {"type": "boolean"}, "allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}}}},
    "data_residency": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capability_function_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M5CAP\\."}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status", "verified_at", "expires_at", "revocation_ref"], "properties": {"status": {"enum": ["pending", "active", "suspended", "revoked", "expired"]}, "verified_at": {"type": ["string", "null"], "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}, "revocation_ref": {"type": ["string", "null"]}}}
  }
}
