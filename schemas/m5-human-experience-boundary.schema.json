{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:human-experience-boundary:v1",
  "title": "M5 Human Experience Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boundary_id", "accountable_entity_ref", "notice", "lawful_basis", "consent", "accessibility", "human_override", "safety_limits", "data_controls", "recovery", "m5canon_gate_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "boundary_id": {"type": "string", "minLength": 1},
    "accountable_entity_ref": {"type": "string", "minLength": 1},
    "notice": {"type": "object", "additionalProperties": false, "required": ["provided", "content_ref", "provided_at"], "properties": {"provided": {"type": "boolean"}, "content_ref": {"type": "string"}, "provided_at": {"type": "string", "format": "date-time"}}},
    "lawful_basis": {"type": "object", "additionalProperties": false, "required": ["basis", "authority_source_ref"], "properties": {"basis": {"type": "string"}, "authority_source_ref": {"type": "string"}}},
    "consent": {"type": "object", "additionalProperties": false, "required": ["required", "status", "subject_ref", "record_ref", "revocable"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["not_requested", "granted", "declined", "withdrawn", "expired", "not_applicable"]}, "subject_ref": {"type": "string"}, "record_ref": {"type": ["string", "null"]}, "revocable": {"type": "boolean"}}},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["accommodations_available", "contact_ref"], "properties": {"accommodations_available": {"type": "array", "items": {"type": "string"}}, "contact_ref": {"type": "string"}}},
    "human_override": {"type": "object", "additionalProperties": false, "required": ["available", "method"], "properties": {"available": {"const": true}, "method": {"type": "string"}}},
    "safety_limits": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["category", "limit", "response"], "properties": {"category": {"enum": ["physical", "psychological", "privacy", "other"]}, "limit": {"type": "string"}, "response": {"type": "string"}}}},
    "data_controls": {"type": "object", "additionalProperties": false, "required": ["minimized", "retention_seconds", "deletion_method"], "properties": {"minimized": {"type": "boolean"}, "retention_seconds": {"type": "integer", "minimum": 0}, "deletion_method": {"type": "string"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["exit_available", "support_ref"], "properties": {"exit_available": {"const": true}, "support_ref": {"type": "string"}}},
    "m5canon_gate_status": {"type": "object", "additionalProperties": false, "required": ["principal", "standing", "delegation", "context", "decision_approval", "commit_activation"], "properties": {"principal": {"$ref": "#/$defs/gate"}, "standing": {"$ref": "#/$defs/gate"}, "delegation": {"$ref": "#/$defs/gate"}, "context": {"$ref": "#/$defs/gate"}, "decision_approval": {"$ref": "#/$defs/gate"}, "commit_activation": {"$ref": "#/$defs/gate"}}}
  },
  "$defs": {"gate": {"enum": ["pass", "fail", "unresolved"]}}
}
