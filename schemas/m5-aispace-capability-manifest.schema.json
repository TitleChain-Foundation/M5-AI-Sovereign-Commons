{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m5:schema:aispace-capability-manifest:v1",
  "title": "M5 AISPACE Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "accountable_operator_ref", "function_ids", "named_roles", "inputs", "outputs", "sensors", "actuators", "spatial_bounds", "data_handling", "refusal_controls", "prohibited_effects", "emergency_stop", "lifecycle"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "accountable_operator_ref": {"type": "string", "minLength": 1},
    "function_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M5CAP\\."}},
    "named_roles": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "sensors": {"type": "array", "items": {"type": "string"}},
    "actuators": {"type": "array", "items": {"type": "string"}},
    "spatial_bounds": {"type": "object", "additionalProperties": false, "required": ["frame", "description"], "properties": {"frame": {"type": "string"}, "description": {"type": "string"}}},
    "data_handling": {"type": "object", "additionalProperties": false, "required": ["minimized", "retention_seconds", "residency"], "properties": {"minimized": {"type": "boolean"}, "retention_seconds": {"type": "integer", "minimum": 0}, "residency": {"type": "array", "items": {"type": "string"}}}},
    "refusal_controls": {"type": "object", "additionalProperties": false, "required": ["evaluated_pre_capture", "supported_channels", "unresolved_action", "spoof_suspected_action"], "properties": {"evaluated_pre_capture": {"const": true, "description": "Evaluated before persistent capture or downstream use; minimal transient processing solely to detect and enforce refusal is permitted and must be discarded when refusal applies."}, "supported_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["glyph", "2d_barcode", "url", "rfid_nfc", "signed_profile", "offline_ledger"]}}, "unresolved_action": {"const": "pause_and_deny"}, "spoof_suspected_action": {"const": "pause_deny_and_escalate"}}},
    "prohibited_effects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "emergency_stop": {"type": "object", "additionalProperties": false, "required": ["independent_of_model", "method"], "properties": {"independent_of_model": {"const": true}, "method": {"type": "string", "minLength": 1}}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status", "expires_at"], "properties": {"status": {"enum": ["draft", "active", "suspended", "revoked", "expired"]}, "expires_at": {"type": ["string", "null"], "format": "date-time"}}}
  }
}
